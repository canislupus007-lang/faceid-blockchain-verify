# Copy this file to .env and fill in your real values.
# Never commit the actual .env file.

# Get a free key at https://serpapi.com/dashboard
SERPAPI_API_KEY=your_serpapi_key_here

# Free public Sepolia RPC endpoint (no signup needed).
# Alternatives if this one is down:
#   https://rpc.sepolia.org
#   https://sepolia.drpc.org
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Your Sepolia testnet wallet's private key (from MetaMask: Account
# details -> Show private key). Use a wallet with ONLY testnet funds,
# never a wallet holding real assets.
WALLET_PRIVATE_KEY=your_wallet_private_key_here
